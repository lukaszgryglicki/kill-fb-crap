{
  "manifest_version": 3,
  "name": "kill-fb-crap",
  "version": "1.0.0",
  "description": "Hide Facebook ads, sponsored and AI junk, and remove fbclid from URLs.",
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://facebook.com/*",
        "https://*.fb.com/*",
        "https://fb.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
